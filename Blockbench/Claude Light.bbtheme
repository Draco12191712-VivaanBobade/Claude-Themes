/*
name: Claude (Light)
author: Draco12191712 (Vivaan Bobade)
version: 1.0.0
borders: false
options:
	icons:
		name: Icons
		options:
			thin: Claude (thin)
			classic: Classic
	cards:
		name: Panels
		options:
			float: Floating cards
			flat: Flat
	accent:
		name: Accent
		options:
			clay: Clay
			blue: Blue
option_values:
	icons: thin
	cards: float
	accent: clay
*/
body {
	--color-ui: #ffffff;
	--color-back: #f9f9f7;
	--color-dark: #fcfcfb;
	--color-border: #e5e4df;
	--color-selected: #e7e7e6;
	--color-elevated: #f3f3f2;
	--color-button: #ededeb;
	--color-bright_ui: #ffffff;
	--color-accent: #c6613f;
	--color-frame: #fcfcfb;
	--color-text: #2c2c2a;
	--color-light: #0b0b0b;
	--color-accent_text: #ffffff;
	--color-bright_ui_text: #131313;
	--color-subtle_text: #7b7974;
	--color-grid: #c9c8bf;
	--color-wireframe: #7b7974;
	--color-checkerboard: #f3f3f0;
	--font-custom-main: anthropic-sans;
	--font-custom-headline: anthropic-serif;
}
@scope (thumbnail) {
	.theme_preview_window{padding:0 3px 3px;gap:3px}
	.theme_preview_sidebar{flex-basis:38px;border-radius:5px;box-shadow:inset 0 0 0 1px rgba(128,128,128,.2)}
	.theme_preview_sidebar::after{background-color:transparent;border-top:1px solid rgba(128,128,128,.2)}
	.theme_preview_menu{border-radius:6px;box-shadow:0 0 0 .5px rgba(128,128,128,.35),0 4px 10px rgba(0,0,0,.25)}
	.theme_preview_menu_header{background-color:rgba(128,128,128,.2);border-radius:4px;height:14px;margin-top:3px}
	.theme_preview_menu_header > .theme_preview_text{background-color:var(--color-light);margin:5px 4px}
	.theme_preview_center{border-color:var(--color-accent);opacity:.8}
	.theme_preview_text{border-radius:9px}
}
@import url("https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..24,300,0..1,0");
#_{}
body{--asdf:#fcfcfb;--x:rgba(11,11,11,.05);--xx:rgba(11,11,11,.09);--xxx:rgba(11,11,11,.2);--tmp:rgba(11,11,11,.08);--tmp2:rgba(11,11,11,.1);--p0p:#ffffff;--sh:0 0 0 .5px #0000001a,0 4px 12px #0000000f,0 16px 40px #00000014;--seg:#ffffff;--blu:#2a78d6;--lnk:#256abf;--red:#d03b3b;--b1:#0b0b0b;--b2:#2c2c2a;--b3:#ffffff;--btn:rgba(11,11,11,.06);--btn2:rgba(11,11,11,.1);--fld:rgba(255,255,255,.5);}

@font-face {
  font-family: "anthropic-sans";
  src: local("Anthropic Sans"), url("file:///Applications/Claude.app/Contents/Resources/fonts/AnthropicSans-Romans-Variable-25x258.ttf") format("truetype");
  font-weight: 300 800;
  font-style: normal
}

@font-face {
  font-family: "anthropic-sans";
  src: local("Anthropic Sans Italic"), url("file:///Applications/Claude.app/Contents/Resources/fonts/AnthropicSans-Italics-Variable-25x258.ttf") format("truetype");
  font-weight: 300 800;
  font-style: italic
}

@font-face {
  font-family: "anthropic-serif";
  src: local("Anthropic Serif"), url("file:///Applications/Claude.app/Contents/Resources/fonts/AnthropicSerif-Romans-Variable-25x258.ttf") format("truetype");
  font-weight: 300 800;
  font-style: normal
}

@font-face {
  font-family: "anthropic-serif";
  src: local("Anthropic Serif Italic"), url("file:///Applications/Claude.app/Contents/Resources/fonts/AnthropicSerif-Italics-Variable-25x258.ttf") format("truetype");
  font-weight: 300 800;
  font-style: italic
}

body {
  --font-main: var(--font-custom-main), -apple-system, BlinkMacSystemFont, system-ui, "Segoe UI", sans-serif;
  --font-headline: var(--font-custom-headline), Georgia, "Times New Roman", serif;
  --font-code: var(--font-custom-code), "SF Mono", ui-monospace, Menlo, Consolas, monospace;
  font-size: 14px;
  -webkit-font-smoothing: antialiased;
  --color-close: var(--red);
  --color-error: var(--red);
  --color-confirm: #35b231;
  --color-warning: #fab219;
}

body[theme-accent=blue] {
  --color-accent: var(--blu);
  --color-accent_text: #fff
}

::selection {
  background: color-mix(in srgb, var(--blu) 35%, transparent);
  color: inherit
}

* {
  scrollbar-color: var(--xxx) transparent
}

.list {
  background-color: transparent
}

.list::-webkit-scrollbar-track {
  background: transparent
}

#page_wrapper {
  border-color: var(--asdf);
  background-color: var(--asdf)
}

#work_screen,
.sidebar,
#main_toolbar,
#status_bar,
#top_slot,
#bottom_slot {
  background-color: var(--asdf)
}

header {
  background-color: var(--asdf)
}

#tab_bar {
  background: var(--asdf)
}

body[mode=start] div#center.checkerboard {
  background-color: var(--asdf)
}

#corner_logo img {
  opacity: .42
}
body.light_mode #corner_logo img{filter:invert(1);opacity:.5}
.checkerboard,.checkerboard_trigger .checkerboard_target{--color-checker_offset:rgba(0,0,0,.12)}
body.light_mode .checkerboard,body.light_mode .checkerboard_trigger .checkerboard_target{--color-checker_offset:rgba(11,11,11,.035)}
body.light_mode .outliner_object .icon[style],body.light_mode .texture .icon[style]{filter:brightness(.68) saturate(1.7)}

li.menu_bar_point {
  font-size: 13px;
  height: 24px;
  margin-top: 3px;
  padding: 0 9px;
  min-width: 0;
  border-radius: 6px;
  display: inline-flex;
  align-items: center;
  color: var(--color-text);
  transition: background-color .12s
}

li.menu_bar_point:hover {
  background: var(--x);
  color: var(--color-light)
}

li.menu_bar_point.opened {
  background: var(--xx);
  color: var(--color-light)
}

div#header_free_bar.app-drag-region {
  font-size: 13px;
  padding-top: 6px;
  color: var(--color-subtle_text)
}

#web_download_button {
  background: transparent;
  font-size: 13px
}

#web_download_button:hover {
  background: transparent
}

#tab_bar {
  padding: 3px 6px 1px
}

#tab_bar .project_tab {
  border-radius: 8px !important;
  height: 28px;
  padding: 3px 6px 3px 8px;
  margin: 0 1px;
  color: var(--color-subtle_text);
  font-size: 13px;
  align-items: center
}

#tab_bar .project_tab.selected {
  background-color: var(--xx);
  color: var(--color-light)
}

#tab_bar .project_tab.selected::before,
#tab_bar .project_tab.selected::after {
  display: none
}

#tab_bar .project_tab:not(.selected):hover {
  background-color: var(--x);
  color: var(--color-light)
}

#tab_bar .project_tab.dragging {
  background-color: var(--p0p);
  box-shadow: var(--sh)
}

#tab_bar .project_tab>.icon {
  font-size: 18px;
  color: var(--color-subtle_text)
}

#tab_bar .project_tab_close_button {
  border-radius: 6px;
  flex-basis: 22px;
  height: 22px
}

#tab_bar .project_tab_close_button:hover {
  background: var(--xx)
}

#tab_bar .project_tab_close_button>* {
  font-size: 16px;
  padding-top: 3px
}

#new_tab_button,
#search_tab_button {
  border-radius: 8px;
  height: 28px;
  margin-top: 0;
  color: var(--color-subtle_text)
}

#new_tab_button:hover,
#search_tab_button:hover {
  background: var(--x);
  color: var(--color-light)
}

#main_toolbar {
  padding: 5px 8px
}

.tool {
  border-radius: 6px;
  transition: background-color .12s, color .12s
}

.tool:hover {
  color: var(--color-light)
}

.toolbar .tool:not(.nslide_tool):not(.bar_select):not(.wide):not(.bar_input):hover,
.panel_tab_bar .tool:hover,
.dialog .tool:hover,
#status_bar .sidebar_toggle_button:hover {
  background-color: var(--x)
}

.tool.enabled {
  background: var(--xx);
  color: var(--color-light);
  border-radius: 6px
}

.tool.enabled>.icon {
  color: var(--color-light)
}

.toolbar_separator {
  opacity: .5
}

#mode_selector {
  background: var(--x);
  border-radius: 10px;
  padding: 2px;
  box-shadow: inset 0 0 0 1px var(--tmp2);
  display: inline-flex !important;
  gap: 2px;
  height: 30px
}

#mode_selector>li {
  height: 26px;
  border-radius: 8px;
  padding: 2px 10px 0 8px;
  font-size: 13px;
  font-weight: 500;
  color: var(--color-subtle_text);
  display: inline-flex;
  align-items: center;
  gap: 2px;
  transition: background-color .12s, color .12s
}

#mode_selector>li>.icon {
  font-size: 18px
}

#mode_selector>li:hover {
  background-color: var(--x);
  color: var(--color-light)
}

#mode_selector>li.selected {
  background-color: var(--seg);
  color: var(--color-light);
  box-shadow: 0 0 0 .5px var(--tmp), 0 1px 3px rgba(0, 0, 0, .18)
}

#mode_selector>li:not(.selected)>.icon {
  color: inherit
}

#status_bar {
  font-size: 12px;
  color: var(--color-subtle_text)
}

#status_bar .sidebar_toggle_button {
  border-radius: 6px
}

#status_bar .status_bar_modifier_key kbd {
  background-color: var(--x);
  box-shadow: inset 0 0 0 1px var(--tmp2);
  border-radius: 4px
}

#status_bar #status_progress {
  background: var(--color-accent)
}

.panel_container,
.panel,
.panel_tab_bar,
.panel_tab_bar.single_tab,
.panel_tab_list>.panel_handle.selected {
  background-color: transparent
}

body:not([theme-cards=flat]) .sidebar>.panel_container:not(.floating) {
  background-color: var(--color-ui);
  border: 4px solid var(--asdf);
  border-radius: 14px;
  box-shadow: inset 0 0 0 1px var(--tmp)
}

body:not([theme-cards=flat]) #left_bar>.panel_container:not(.floating) {
  border-right-width: 0;border-left-width:2px;border-top-right-radius:10px;border-bottom-right-radius:10px
}

body:not([theme-cards=flat]) #right_bar>.panel_container:not(.floating) {
  border-left-width: 0;   border-right-width:2px;border-top-left-radius:10px;border-bottom-left-radius:10px
}

body:not([theme-cards=flat]) .sidebar>.panel_container:not(.floating)+.panel_container:not(.floating) {
  border-top-width: 0
}

body[theme-cards=flat] .sidebar>.panel_container:not(.floating) {
  background-color: var(--color-ui);
  border-bottom: 1px solid var(--tmp2)
}

body[theme-cards=flat] .sidebar {
  background-color: var(--color-ui)
}

body[theme-cards=flat] #left_bar {
  border-right: 1px solid var(--tmp2)
}

body[theme-cards=flat] #right_bar {
  border-left: 1px solid var(--tmp2)
}

.panel_container.floating {
  background-color: var(--color-ui);
  border: none;
  border-radius: 12px;
  box-shadow: var(--sh)
}

.panel_container:not(.sidebar > *):not(.floating) {
  background-color: var(--color-ui)
}
body:not([theme-cards=flat]) #bottom_slot > .panel_container:not(.floating){border-radius:12px 12px 0 0;box-shadow:inset 0 1px 0 0 var(--tmp),inset 1px 0 0 0 var(--tmp),inset -1px 0 0 0 var(--tmp)}
body:not([theme-cards=flat]) #top_slot > .panel_container:not(.floating){border-radius:0 0 12px 12px;box-shadow:inset 0 -1px 0 0 var(--tmp),inset 1px 0 0 0 var(--tmp),inset -1px 0 0 0 var(--tmp)}

#right_bar .panel_container.topmost_panel .panel_tab_bar:not(.single_tab)::before {
  display: none
}

.panel_tab_list>.panel_handle {
  text-transform: none;
  letter-spacing: 0;
  font-size: 13px;
  font-weight: 500;
  color: var(--color-subtle_text);
  border-radius: 8px;
  padding: 0 10px;
  height: 28px;
  margin: 4px 1px 0;
  align-items: center;
  min-width: 0;
  flex-grow: 0
}

.panel_tab_list>.panel_handle:hover {
  color: var(--color-light);
  background-color: var(--x)
}

.panel_tab_bar:not(.single_tab) .panel_tab_list>.panel_handle.selected {
  background-color: var(--xx);
  color: var(--color-light)
}

.panel_tab_bar.single_tab .panel_tab_list>.panel_handle {
  color: var(--color-subtle_text);
  padding-left: 12px
}

.panel_tab_bar.single_tab .panel_tab_list>.panel_handle:hover {
  background: transparent
}

.panel_tab_list {
  margin-top: 0;
  height: 100%;
  padding-left: 4px;
  gap: 2px
}

.panel_tab_bar .panel_control {
  color: var(--color-subtle_text)
}

.panel_sidebar_resize_handle:hover,
.panel_sidebar_resize_handle.dragging,
.resizer:hover,
.resizer.dragging {
  background-color: color-mix(in srgb, var(--color-accent) 70%, transparent)
}

p.panel_toolbar_label {
  font-size: 12px;
  color: var(--color-subtle_text);
  font-weight: 500
}

.outliner_object {
  border-radius: 6px;
  font-size: 13px;
  transition: background-color .1s
}

.outliner_object:hover {
  background-color: var(--x)
}

.outliner_object.selected,
.outliner_object:active,
.outliner_object.selected:hover {
  background-color: var(--xx)
}

.outliner_object .icon {
  color: var(--color-subtle_text)
}

.outliner_object.selected .icon {
  color: var(--color-text)
}

#cubes_list {
  padding: 0 6px
}

.collection,
.texture,
.animation,
.texture_layer {
  border-radius: 8px
}

.collection:hover,
.texture:hover,
.animation:hover {
  background-color: var(--x)
}

.collection.selected,
.texture.selected,
.animation.selected,
.texture_layer.selected,
.collection:active {
  background: var(--xx)
}

.texture.multi_selected {
  background-color: var(--x)
}

.texture_layer:hover {
  background-color: var(--x)
}

.contextMenu {
  background-color: var(--p0p);
  color: var(--color-text);
  border-radius: 12px;
  padding: 5px;
  box-shadow: var(--sh);
  min-width: 190px;
  font-size: 14px
}

.contextMenu li {
  border-radius: 8px;
  height: 32px;
  padding: 5px 10px 5px 36px;
  align-items: center
}

.contextMenu li.focused,
.contextMenu li.parent.opened {
  background-color: var(--x);
  color: var(--color-light)
}

.contextMenu li>.icon,
.contextMenu li>i {
  color: var(--color-subtle_text)
}

.contextMenu li.focused>.icon,
.contextMenu li.focused>i {
  color: var(--color-light)
}

.contextMenu .menu_more_button:hover,
.hybrid_parent.opened .menu_more_button {
  background-color: var(--xx);
  color: var(--color-light)
}

.contextMenu li.menu_separator {
  height: 1px;
  min-height: 1px;
  padding: 0;
  margin: 5px 4px;
  background-color: var(--tmp2);
  border-radius: 0
}

.contextMenu li.menu_separator.has_label {
  height: auto;
  background: transparent;
  margin-top: 8px;
  padding: 0 10px
}

li.menu_separator.has_label>label {
  background-color: var(--p0p);
  color: var(--color-subtle_text);
  font-size: 12px
}

.contextMenu li label.keybinding_label,
.contextMenu .keybinding_label {
  color: var(--color-subtle_text);
  font-size: 12px
}

.contextMenu .menu_search_bar,
.contextMenu input {
  border-radius: 8px
}

.tooltip {
  background: var(--p0p);
  color: var(--color-light);
  border-radius: 8px;
  box-shadow: var(--sh);
  font-size: 12px;
  height: auto;
  min-height: 26px;
  padding: 4px 9px;
  font-weight: 500
}

.tooltip_description {
  background-color: var(--p0p);
  color: var(--color-text);
  border-radius: 8px;
  box-shadow: var(--sh);
  font-weight: 400
}

#quick_message_box,
#cursor_tooltip,
.uv_message_box,
.annotation {
  background-color: var(--p0p);
  color: var(--color-light);
  border-radius: 10px;
  box-shadow: var(--sh)
}

.toast_notification {
  background-color: var(--p0p);
  color: var(--color-light);
  border-radius: 12px;
  box-shadow: var(--sh)
}

.toast_notification>.icon {
  color: var(--color-accent)
}

button {
  border-radius: 8px;
  box-shadow: none;
  background: var(--btn);
  color: var(--color-light);
  font-weight: 500;
  font-size: 14px;
  transition: background-color .12s
}

button:hover {
  background: var(--btn2);
  color: var(--color-light)
}

button:focus {
  text-decoration: none
}

button:focus-visible {
  box-shadow: 0 0 0 1px var(--asdf), 0 0 0 2.5px var(--blu)
}

button.minor {
  background: transparent
}

button.minor:hover {
  background: var(--x)
}

.dialog_bar>button.confirm_btn,
.dialog_bar>button.confirm_btn:not(:hover),
button.confirm_btn {
  background-color: var(--b1);
  color: var(--b3)
}

.dialog_bar>button.confirm_btn:hover,
button.confirm_btn:hover {
  background-color: var(--b2);
  color: var(--b3)
}

#web_download_button,
#web_download_button:hover {
  background: transparent
}

.dark_bordered,
textarea,
.prism-editor-wrapper {
  background-color: var(--fld);
  border: 1px solid var(--tmp2);
  border-radius: 8px
}

.dark_bordered:focus,
textarea:focus,
.dark_bordered:focus-within {
  border-color: var(--blu);
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--blu) 22%, transparent)
}

input[type=text],
input[type=number],
input[type=search] {
  caret-color: var(--color-accent)
}

div.nslide {
  background-color: var(--fld);
  box-shadow: inset 0 0 0 1px var(--tmp2);
  border-radius: 6px
}

div.nslide:hover {
  background-color: var(--x)
}

div.nslide.editing,
div.nslide:focus {
  box-shadow: inset 0 0 0 1px var(--blu), 0 0 0 3px color-mix(in srgb, var(--blu) 22%, transparent)
}

div.bb-select,
select {
  background-color: var(--fld);
  box-shadow: inset 0 0 0 1px var(--tmp2);
  border-radius: 8px;
  color: var(--color-text)
}

div.bb-select:hover {
  background-color: var(--x);
  color: var(--color-light)
}

.tool.bar_select.icon_mode {
  background-color: var(--fld)
}

.tool.bar_select .select_option.selected {
  background: var(--xx)
}

select option {
  background-color: var(--p0p)
}

input[type=checkbox]:checked::before {
  color: var(--color-accent)
}

input[type=checkbox].toggle_switch {
  height: 20px;
  width: 34px;
  border-radius: 99px;
  background-color: var(--xxx);
  box-shadow: none;
  --color: #fff
}

input[type=checkbox].toggle_switch::before {
  width: 16px;
  height: 16px;
  margin: 2px;
  box-shadow: 0 1px 2px rgba(0, 0, 0, .25)
}

input[type=checkbox].toggle_switch:checked {
  background-color: var(--color-accent);
  --color: #fff
}

input[type=checkbox].toggle_switch:checked::before {
  left: calc(100% - 20px)
}

input[type=range] {
  accent-color: var(--color-accent)
}

.form_inline_select>li {
  background-color: var(--x);
  border-radius: 8px
}

.form_inline_select>li.selected {
  background-color: var(--seg);
  color: var(--color-light);
  box-shadow: 0 0 0 .5px var(--tmp), 0 1px 3px rgba(0, 0, 0, .18)
}

ul.form_multi_select>li {
  background-color: var(--x);
  border-radius: 8px
}

.progress_bar {
  background-color: var(--x);
  border-radius: 99px
}

.progress_bar_inner {
  background-color: var(--color-accent);
  border-radius: 99px
}

a[href] {
  color: var(--lnk);
  text-decoration: none
}

a[href]:hover {
  color: var(--lnk);
  text-decoration: underline
}

#blackout.darken {
  background-color: #000;
  opacity: .5
}

dialog {
  background-color: var(--color-ui);
  border-radius: 16px !important;
  box-shadow: var(--sh);
  overflow: hidden
}

.dialog_handle {
  background: transparent;
  box-shadow: none;
  height: 48px;
  padding: 13px 18px 0;
  font-family: var(--font-headline);
  font-size: 19px;
  font-weight: 400;
  color: var(--color-light);
  letter-spacing: -.01em
}

.dialog_handle .dialog_title {
  font-family: inherit
}

.dialog_close_button {
  top: 9px;
  right: 10px;
  width: 30px;
  height: 30px;
  padding: 3px;
  border-radius: 8px !important;
  color: var(--color-subtle_text)
}

.dialog_close_button:hover {
  background-color: var(--x);
  color: var(--color-light)
}

.dialog_sidebar {
  background-color: transparent;
  border-right: 1px solid var(--tmp2)
}

.dialog_sidebar .dialog_sidebar_pages li {
  border-left: none;
  border-radius: 8px;
  margin: 1px 8px;
  width: calc(100% - 16px);
  padding: 6px 12px 6px 22px;
  font-size: 14px;
  color: var(--color-text)
}

.dialog_sidebar .dialog_sidebar_pages li:hover {
  background-color: var(--x);
  color: var(--color-light)
}

.dialog_sidebar .dialog_sidebar_pages li.selected {
  background-color: var(--xx);
  border-left: none;
  color: var(--color-light)
}

.dialog_sidebar_separator {
  font-size: 12px
}

.dialog_sidebar_separator>span {
  background-color: var(--tmp2);
  height: 1px
}

.dialog_sidebar .dialog_sidebar_actions {
  border-top: 1px solid var(--tmp2)
}

.dialog_sidebar .dialog_sidebar_actions li {
  border-radius: 8px;
  font-size: 13px
}

.dialog_sidebar .dialog_sidebar_actions li:hover {
  background-color: var(--x)
}

dialog h2 {
  font-family: var(--font-main);
  font-weight: 500;font-size:20px;
  letter-spacing: -.01em;color:var(--color-light)
}
#web_download_button a,#web_download_button a:hover{color:inherit;text-decoration:none}

.settings_list .setting_plugin_label,
.settings_list input[type=number],
.keybind_line>div.keybindslot {
  background-color: var(--fld);
  border-radius: 6px
}

.keybindslot .modifier,
.keybindslot .key {
  background: var(--x);
  box-shadow: inset 0 0 0 1px var(--tmp2);
  border-radius: 5px
}

#theme_list .theme {
  background-color: var(--x);
  border-radius: 12px;
  box-shadow: inset 0 0 0 1px var(--tmp2);
  overflow: hidden
}

#theme_list .theme:hover {
  background-color: var(--xx)
}

#theme_list .theme.selected {
  box-shadow: inset 0 0 0 1.5px var(--color-accent)
}

#plugin_list>li {
  background-color: transparent;
  border-radius: 10px
}

#plugin_list>li:hover {
  background-color: var(--x)
}

#plugin_list>li.selected {
  background-color: var(--xx)
}

.plugin_tag_list li {
  background-color: var(--xx);
  color: var(--color-text)
}

#action_selector ul {
  background-color: var(--p0p);
  border-radius: 12px;
  box-shadow: var(--sh)
}

#action_selector ul>li {
  border-radius: 8px
}

#action_selector ul>li.selected {
  background-color: var(--x);
  color: var(--color-light)
}

#action_selector>.tool {
  background-color: var(--fld)
}

.dialog_message_box_command:hover {
  background-color: var(--x);
  color: var(--color-light)
}

#edit_history_list ul li.selected,
ul#view_backups_list>li.selected,
ol.pagination_numbers>li.selected {
  background-color: var(--xx);
  color: var(--color-light)
}

ol.pagination_numbers>li:hover {
  background-color: var(--x);
  color: var(--color-light)
}

#model_select_list li.selected,
#import_texture_list li:hover {
  background-color: var(--xx)
}

.prism-editor-wrapper .prism-editor__line-numbers {
  background-color: transparent !important
}

.prism-editor__autocomplete {
  background-color: var(--p0p);
  border-radius: 10px;
  box-shadow: var(--sh)
}

.prism-editor__autocomplete li.selected {
  background-color: var(--x)
}

.markdown pre,
blockquote,
.markdown table,
dialog p>code {
  background: var(--fld);
  border-radius: 8px
}

.markdown code,
dialog p>code {
  font-family: var(--font-code);
  font-size: .9em
}

#start_screen {
  background: var(--asdf)
}

#start_screen>content {
  background: transparent;
  box-shadow: none
}

#start_screen h1,
#start_screen h2,
#start_screen h3 {
  font-family: var(--font-headline);
  font-weight: 400;
  letter-spacing: -.015em;
  color: var(--color-light)
}

#start_screen .recent_project.thumbnail {
  background-color: var(--color-ui);
  border-radius: 12px;
  box-shadow: inset 0 0 0 1px var(--tmp);
  overflow: hidden
}

#start_screen .recent_project.thumbnail:hover {
  background-color: var(--x)
}

#start_screen .recent_project:not(.thumbnail):hover {
  background-color: var(--x)
}

#start_screen .recent_project {
  border-radius: 8px
}

#start_files li.format_entry {
  border-radius: 8px
}

#start_files li.format_entry:hover {
  background-color: var(--x);
  color: var(--color-light)
}

#start_files li.format_entry.selected {
  background-color: var(--xx);
  color: var(--color-light)
}

#start_files li.format_entry .icon {
  color: var(--color-subtle_text)
}

.format_target span {
  background-color: var(--color-accent);
  color: var(--color-accent_text);
  border-radius: 99px
}

.splash_art_slideshow_points>li.selected::after {
  background-color: var(--color-light)
}

.project_thumbnail {
  background-color: var(--x)
}

#timeline_body,
#timeline_time_wrapper {
  background-color: var(--asdf)
}

#panel_timeline {
  background-color: transparent
}

.channel_head,
#timeline_corner,
.animator_channel_bar>.keyframe_section {
  background-color: var(--color-ui)
}

.animator.selected .animator_head_bar .channel_head {
  background-color: var(--xx)
}

#timeline_playhead::after {
  background-color: var(--color-accent)
}

#animation_controllers_wrapper {
  background-color: var(--asdf)
}

.controller_state {
  border-radius: 12px;
  box-shadow: inset 0 0 0 1px var(--tmp)
}

.controller_state.selected .controller_state_title_bar {
  background-color: var(--xx);
  color: var(--color-light)
}

.UVEditor {
  --color-background: var(--asdf)
}

#uv_cube_face_bar li {
  border-radius: 6px
}

#uv_cube_face_bar li.selected {
  background: var(--xx)
}

.uv_face_properties_line:nth-child(even) {
  background-color: var(--x)
}

.uv_face_properties_line:nth-child(even) .dark_bordered {
  background-color: var(--fld)
}

#color_panel_head .side input {
  background-color: var(--fld);
  border-radius: 6px
}

.preview .preview_menu {
  background-color: var(--p0p);
  border-radius: 10px;
  box-shadow: var(--sh)
}

.orbit_gizmo:not(.mouse_active) .orbit_gizmo_side:hover {
  background-color: var(--xx)
}

.reference_image_toolbar,
.toolbar[toolbar_id=reference_images],
#gif_recording_controls {
  background-color: var(--p0p);
  border-radius: 10px;
  box-shadow: var(--sh)
}

body[theme-icons=thin] .material-icons,
body[theme-icons=thin] .material-symbols-outlined {
  font-family: "Material Symbols Rounded", "Material Icons";
  font-variation-settings: "FILL" 0, "wght" 300, "GRAD" 0, "opsz" 20
}

body[theme-icons=thin] .tool.enabled .material-icons,
body[theme-icons=thin] #mode_selector>li.selected .material-icons {
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 20
}